<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.eaiselp</groupId>
        <artifactId>eaiselp-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>eaiselp-data</artifactId>
    <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>com.baomidou</groupId><artifactId>mybatis-plus-spring-boot3-starter</artifactId></dependency>
        <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId></dependency>
        <dependency><groupId>com.eaiselp</groupId><artifactId>eaiselp-common</artifactId></dependency>
        <!-- M3-3 新增：UserService 内 BCrypt 加密密码（仅 crypto，不引完整 spring-security，与 JWT 无状态冲突）-->
        <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-crypto</artifactId></dependency>
    </dependencies>
    <!-- library 模块禁止配 spring-boot-maven-plugin / 依赖 nacos-discovery（同 capability，ADR-001 P2 / ES-001 §2.2 / QG G2+G5）-->
    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- Wave3 单测：JDK 26 + Mockito/ByteBuddy 兼容（同 eaiselp-runtime）。
                 ByteBuddy 官方支持到 Java 22，JDK 26 需开启 experimental 模式才能生成 mock 字节码
                 （本模块仅 mock Mapper 接口，严格说接口 mock 不触发 final 类插桩，但显式声明保证 QA 跑 mvn test 不漏 -D 参数）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
