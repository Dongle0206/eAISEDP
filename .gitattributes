# Auto-detect text vs binary, normalize line endings
* text=auto eol=lf

# Windows-specific scripts keep CRLF (must run on Windows)
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Explicit binary types (no line ending processing)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.ico   binary
*.zip   binary
*.jar   binary
*.class binary

# Markdown / YAML / Java / XML use LF
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.java  text eol=lf
*.xml   text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.css   text eol=lf
